# SolarFlex Environment Configuration
# Copy this file to .env and fill in actual values

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/solarflex.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Energy Settings
BATTERY_CAPACITY_WH=1000
SOLAR_PANEL_WATTAGE=500
MIN_BATTERY_SOC_PERCENT=20

# Crop Profiles (default module)
DEFAULT_MODULE_ID=module_01